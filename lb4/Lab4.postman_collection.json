{
  "info": {
    "name": "Lab 4 - API Testing",
    "description": "Лабораторна робота №4. Автоматизоване тестування HTTP API (Postman Echo) за допомогою Postman Collection v2.1.\nКолекція містить 3 запити та 11 автоматизованих тестів у блоці scripts -> exec.\nЗмінна колекції: baseUrl = https://postman-echo.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://postman-echo.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 GET with Params",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/get?name=Артем&role=student",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "get"
          ],
          "query": [
            {
              "key": "name",
              "value": "Артем",
              "disabled": false
            },
            {
              "key": "role",
              "value": "student",
              "disabled": false
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type contains application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"args.name equals Артем\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.args.name).to.eql(\"Артем\");",
              "});",
              "",
              "pm.test(\"args.role equals student\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.args.role).to.eql(\"student\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 POST JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "disabled": false
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": \"Backpack\",\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "post"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response body has data property\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"data\");",
              "});",
              "",
              "pm.test(\"data.product equals Backpack\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.product).to.eql(\"Backpack\");",
              "});",
              "",
              "pm.test(\"data.quantity equals 2\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.quantity).to.eql(2);",
              "});",
              "",
              "pm.test(\"data.quantity is a number\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.quantity).to.be.a(\"number\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Negative - 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/status/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status",
            "404"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Body field status equals 404\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.eql(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
